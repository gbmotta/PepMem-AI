# Copie para .env e preencha (não commite .env)
# Alternativa local: .secrets/huggingface_token.txt (também gitignored)
HF_USERNAME=
HF_TOKEN=
HF_SPACE=pepmem-ai

# Login do dashboard Streamlit (alternativa a .streamlit/secrets.toml)
# AUTH_USER=admin
# AUTH_PASSWORD=troque-esta-senha
# Só para desenvolvimento local sem senha (não use em Cloud/HF):
# PEPMEM_AUTH_DISABLED=1

# Narrativa local (opcional, sem API de LLM)
# PEPMEM_GGUF_PATH=/caminho/para/qwen2.5-0.5b-instruct-q4_k_m.gguf
# PEPMEM_LLM_AUTO_DOWNLOAD=1
# PEPMEM_GGUF_REPO=Qwen/Qwen2.5-0.5B-Instruct-GGUF
